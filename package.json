    "@types/react-dom": "19.0.2",
    "@typescript-eslint/parser": "^8.0.0",
    "autoprefixer": "^10.4.14",
    "concurrently": "^10.0.5",
    "cspell": "^6.31.1",
    "eslint-config-prettier": "^9.0.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.1",
    "partyserver": "^0.5.10",
    "postcss": "^8.4.23",
    "prettier": "^2.8.7",
    "sass": "^1.68.0",
    "tailwindcss": "^3.3.1",
    "wrangler": "^4.125.0"

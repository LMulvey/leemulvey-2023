{
  "name": "leemulvey-2023",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently -n next,party -c blue,magenta \"npm:dev\" \"npm:party:dev\"",
    "build": "next build",
    "start": "next start -p 3004",
    "lint": "eslint --fix",
    "lint:cspell": "cspell './**/*.{ts,tsx}' --no-progress --gitignore",
    "party:dev": "wrangler dev --config party/wrangler.jsonc",
    "party:deploy": "wrangler deploy --config party/wrangler.jsonc",
    "prepare": "husky install"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "cvu": "^1.0.0",
    "eslint": "8.57.0",
    "eslint-config-next": "15.1.3",
    "eslint-plugin-canonical": "^4.12.0",
    "framer-motion": "^11.16.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.469.0",
    "next": "15.1.9",
    "next-mdx-remote": "6.0.0",
    "next-themes": "^0.4.6",
    "partysocket": "^1.3.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "rehype-pretty-code": "^0.13.2",
    "rehype-starry-night": "^2.0.0",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^1.14.0",
    "tailwindcss-animate": "^1.0.5",
    "typescript": "5.1.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.1",
